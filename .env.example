# Copy to .env (npm run setup does this for you). .env is git-ignored.

# Required. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides. The defaults below match Google's docs as of November 2026.
GEMINI_API_VERSION=v1beta
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LIVE_DEFAULT_MODEL=gemini-3.8-live
LIVE_DEFAULT_VOICE=Kore
BACKEND_PORT=5199
